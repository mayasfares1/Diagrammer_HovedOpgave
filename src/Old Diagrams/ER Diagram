@startuml
entity Bruger {
  * BrugerID : int
  * Navn : string
  * Email : string
  --
  IndtastTimer()
  IndtastPause()
  TilføjAfvigelser()
  SeLøn()
  TjekOverholdelse()
}

entity Superbruger {
  * SuperbrugerID : int
  * Navn : string
  * Email : string
  --
  ÆndrRegler()
  TilføjRegel()
  SletRegel()
  SætPrioritet()
}

entity SystemKontroller {
  --
  BehandlBrugerInput()
  BeregnLøn()
  TjekOverholdelseAfRegler()
  ÆndrRegler()
}

entity Database {
  --
  GemBrugerData()
  HentRegler()
  OpdaterRegler()
  GemBeregnedeData()
}

entity API {
  --
  HentRegler()
  OpdaterRegler()
}

entity Admin {
  * id : int
  * user_id : int
  * ActionType : string
  * Timestamp : datetime
  * Status : string
}

Bruger --> SystemKontroller
Superbruger --> SystemKontroller
SystemKontroller --> Database
SystemKontroller --> API
Admin --> Database
@enduml
